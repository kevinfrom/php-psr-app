{
    "name": "kevinfrom/php-psr-app",
    "description": "A simple PHP web app built entirely using PSR standards.",
    "type": "project",
    "license": "MIT",
	"scripts": {
		"qa": [
			"@rector",
			"@static-analysis",
			"@lint",
            "@test"
		],
		"rector": "rector",
		"static-analysis": "phpstan",
		"lint": "php-cs-fixer check",
		"lint:fix": "php-cs-fixer fix",
        "test": "phpunit tests --configuration phpunit.xml"
	},
    "authors": [
        {
            "name": "Kevin From",
            "email": "kf+bitbucket@vestjyskmarketing.dk"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "KevinFrom\\PhpPsr\\App\\": "app/src/",
            "KevinFrom\\PhpPsr\\Core\\": "core/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KevinFrom\\PhpPsr\\Tests\\": "tests"
        }
    },
    "require": {
		"php": "^8.1",
        "psr/clock": "^1.0"
	},
    "require-dev": {
        "rector/rector": "^2.2.14",
        "phpstan/phpstan": "^2.1.33",
        "friendsofphp/php-cs-fixer": "^3.91.3",
        "phpunit/phpunit": "^10.5.60",
        "symfony/var-dumper": "^6.4.26",
        "psr/container": "^2.0"
    }
}
