{
    "name": "kevinfrom/php-psr-app",
    "description": "A simple PHP web app built entirely using PSR standards.",
    "type": "project",
    "license": "MIT",
	"scripts": {
		"qa": [
			"@rector",
			"@phpstan"
		],
		"rector": "rector",
		"phpstan": "phpstan"
	},
    "authors": [
        {
            "name": "Kevin From",
            "email": "kf+bitbucket@vestjyskmarketing.dk"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "KevinFrom\\PhpPsr\\App\\": "app/src/",
            "KevinFrom\\PhpPsr\\Core\\": "core/src/"
        }
    },
    "require": {
		"php": "^8.1"
	},
    "require-dev": {
        "rector/rector": "^2.2",
        "phpstan/phpstan": "^2.1"
    }
}
